# Per vendor arm-native-toolchain guide (section 3.5): force LF for text files
# so Windows-checked-out code runs correctly on the robot's Linux boards.
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.launch.py text eol=lf

# Binaries stay untouched
*.so    binary
*.zip   binary
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.tar.gz binary
*.tgz   binary
