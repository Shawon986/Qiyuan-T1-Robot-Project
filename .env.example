# Copy this file to D:\Qiyuan T1 Robotics project\.env and fill in real values.
# .env is gitignored - never commit real keys.

# iFlytek (Cantonese ASR + TTS) - https://console.xfyun.cn
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# Qwen / DashScope - https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# Volcano TOS - https://console.volcengine.com/tos
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_ENDPOINT=

# SeeDance / BytePlus ModelArk - https://console.byteplus.com
SEEDANCE_API_KEY=
SEEDANCE_MODEL_ID=seedance-2.0-fast

# Robot SSH (from PrimeBot after-sales support)
ROBOT_SSH_HOST=
ROBOT_SSH_USER=run
ROBOT_SSH_PASSWORD=
