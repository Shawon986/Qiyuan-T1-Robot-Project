digraph frontend_demo_state {
  rankdir=TB;
  fontname="Helvetica";
  bgcolor="#0a0e1a";
  label="展示页面 · 演示状态机（已实现于 v1-command-center.html · high）\n2026-10-08 · flow-visualizer + graphviz";
  labelloc="t";
  labeljust="l";
  fontcolor="#e8ecf4";
  fontsize=13;

  node [shape=box, style="rounded,filled", fillcolor="#111832", color="#4a5568", fontcolor="#e8ecf4", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, fontcolor="#8892a8", color="#4a5568"];

  standby  [label="待机 standby\n粒子动画 + 产品介绍", fillcolor="#0d1225"];
  climb    [label="生成中 generating\n假进度 0→95%\nstartFakeProgress()", color="#00d4ff"];
  hold     [label="95% 保持 hold\n呼吸循环 · 等真实就绪\nenterHold()", color="#00d4ff"];
  ready    [label="完成 100%\nonVideoReady()", color="#c9a84c"];
  complete [label="完成态 complete\n约3s 勾选动画", color="#c9a84c"];
  video    [label="播放 video\n真实 / 预录视频", color="#c9a84c"];
  failed   [label="失败 failed\n提示 + 回待机\nonDemoFailed()", color="#ef4444"];

  standby  -> climb    [label="轮询到 round变化 & phase=generating\n(本地: runDemo / 控制面板)"];
  climb    -> hold     [label="爬到 95% (约28s)"];
  hold     -> ready    [label="phase=ready + videoUrl", color="#c9a84c"];
  hold     -> failed   [label="phase=failed", color="#ef4444"];
  ready    -> complete [label="0.8s"];
  complete -> video    [label="约3s"];
  video    -> standby  [label="播放结束 +3s\n等待下一轮"];
  failed   -> standby  [label="约2.5s\n(V1.2 接预录兜底)"];
}
